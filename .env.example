# ---- DNNLS Live Arena configuration (copy to .env) ----

# Secret the teacher enters in the browser to manage sessions. CHANGE THIS.
TEACHER_SECRET=change-me-please

# Port published on the host (students browse to http://<host>:ARENA_PORT).
ARENA_PORT=8000

# PostgreSQL password (internal to Docker Compose).
POSTGRES_PASSWORD=arena

# ---- submissions ----
MAX_UPLOAD_BYTES=52428800            # 50 MB
SUBMISSION_MIN_INTERVAL_SECONDS=5    # per-participant flood protection
MAX_PENDING_SUBMISSIONS_PER_PARTICIPANT=1
ZIP_MAX_FILES=500
ZIP_MAX_UNCOMPRESSED_BYTES=209715200 # 200 MB

# ---- sandboxed Python runner ----
RUNNER_IMAGE=dnnls-arena-runner:latest
RUNNER_TIMEOUT_SECONDS=30
RUNNER_CPUS=1.0
RUNNER_MEMORY=512m
RUNNER_PIDS_LIMIT=64
RUNNER_TMP_SIZE=256m

# ---- misc ----
LOG_LEVEL=INFO
SSE_POLL_INTERVAL_SECONDS=0.5
